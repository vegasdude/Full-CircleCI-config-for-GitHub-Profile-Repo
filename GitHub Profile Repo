Yaml

version: 2.1

jobs:
 update-readme:
  docker:
   - image: cimg/base:stable
  steps:
   - checkout

   - run:
      name: Install git tools
      command:|
       sudo apt-get update -y
       sudo apt-get install -y git

   - run:
name: Update "Last updated" in README.md
      command:|
       echo "Updating README.md..."
       if grep -q "Last updated:" README.md; then
sed -i "s/Last updated:.*/Last updated: $(date '+%Y-%m-%d %H:%M:%S')/"README.md
       else
        echo "\n Last updated: $(date'+%Y-%m-%d %H:%M.%S')" >> README.md
        fi

  - run:
     name: commit and push change
     command:|
      git config user.name " CircleCI Bot"
      git config user.email
"circleci@users.noreply.github.com"
      git add README.md
      git commit -m "Auto-update README timestamp
[skip ci]" || echo "No changes to commit"
      git push origin $CIRCLE - BRANCH

workflows:
 version: 2
 auto_update_readme:
  jobs:
   -update-readme:
     filters:
       branches:
        only: main
